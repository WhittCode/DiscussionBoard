@page "{id:int}"
@model DiscussionBoard.Pages.Discussions.EditModel
@{
    ViewData["Title"] = "Modify Conversation";
}

<div class="container mt-4">
    <h2>Modify Conversation</h2>
    <form method="post" class="mt-4">
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label">Title</label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Content" class="form-label">Content</label>
            <textarea asp-for="Input.Content" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Input.Content" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-page="./Details" asp-route-threadId="@Model.Id" class="btn btn-secondary">Cancel</a>
    </form>
</div>

