@page "{forumId:int}"
@model DiscussionBoard.Pages.Discussions.CreateModel
@{
    ViewData["Title"] = "New Conversation";
}

<div class="container mt-4">
    <h2>Start a New Conversation</h2>
    <form method="post" class="mt-4">
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label">Thread Title</label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Content" class="form-label">Message Body</label>
            <textarea asp-for="Input.Content" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Input.Content" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Publish Thread</button>
        <a asp-page="/Forums/Details" asp-route-id="@Model.ForumId" class="btn btn-secondary">Cancel</a>
    </form>
</div>
