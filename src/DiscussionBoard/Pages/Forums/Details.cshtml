@page "/Forum/{id:int}"
@model DiscussionBoard.Pages.Forums.DetailsModel
@{
    ViewData["Title"] = Model.Forum.Name;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@Model.Forum.Name</h1>
            <p class="lead text-muted">@Model.Forum.Description</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Discussions/Create" asp-route-forumId="@Model.Forum.Id" class="btn btn-primary">Start New Thread</a>
        }
    </div>

    <hr />

    @if (!Model.Threads.Any())
    {
        <div class="alert alert-info">No conversations running in this forum branch space yet.</div>
    }
    else
    {
        foreach (var thread in Model.Threads)
        {
            <partial name="_ThreadCard" model="thread" />
        }
    }
</div>
