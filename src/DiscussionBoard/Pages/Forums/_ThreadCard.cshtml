@model DiscussionBoard.Models.DiscussionThread

<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">
            <a asp-page="/Discussions/Details" asp-route-threadId="@Model.Id" class="text-decoration-none">@Model.Title</a>
        </h5>
        <p class="card-text text-truncate text-muted">@Model.Content</p>
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-secondary">Posted by @(Model.ApplicationUser?.UserName ?? "Anonymous") on @Model.CreatedAt.ToString("g")</small>
            @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.ApplicationUserId)
            {
                <a asp-page="/Discussions/Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Edit Thread</a>
            }
        </div>
    </div>
</div>
