@page
@model RegisterModel
@using DiscussionBoard.Services
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>Create a new account.</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Custom Profile Selection Fields -->
            <div class="form-group mb-3">
                <label asp-for="Input.Profile.DisplayName" class="form-label font-weight-bold">Display Name</label>
                <input asp-for="Input.Profile.DisplayName" class="form-control" placeholder="Choose a public display name" />
                <span asp-validation-for="Input.Profile.DisplayName" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label class="form-label font-weight-bold">Select Registration Avatar</label>
                <div class="row">
                    @foreach (var option in AvatarCatalog.Options)
                    {
                        <div class="col-4 text-center mb-2">
                            <label class="d-block p-2 border rounded cursor-pointer">
                                <input type="radio" asp-for="Input.Profile.AvatarId" value="@option.Id" checked="@(option.Id == "default" ? "checked" : null)" />
                                <img src="@AvatarCatalog.ImagePath(option.Id)"
                                     class="rounded-circle img-fluid d-block mx-auto mt-1"
                                     alt="Avatar option: @option.Id"
                                     style="width: 25px; height: 25px; object-fit: cover;" />
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="Input.Profile.AvatarId" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
